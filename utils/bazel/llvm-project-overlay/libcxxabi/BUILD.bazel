# Bazel build for libc++abi, the Itanium C++ ABI runtime used by libc++.
#
# `:cxxabi` is a static library providing exception handling (__cxa_*), RTTI
# support, the demangler, guard variables and operator new/delete.
# `//libcxx:cxx` depends on it, so consumers normally only list libc++.
#
# The configuration follows the libcxxabi/CMakeLists.txt defaults: exceptions,
# threads and the operator new/delete definitions are on. Unwinding comes from
# the toolchain's unwinder (libgcc_s, libSystem, ...) rather than from a Bazel
# build of libunwind.
#
# libc++abi implements the Itanium ABI only. On the MSVC ABI (cl.exe and
# clang-cl) the vcruntime takes its place, so the library is marked
# incompatible with those compilers; MinGW-style Windows targets use it.

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//:workspace_root.bzl", "workspace_root")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
)

licenses(["notice"])

workspace_root(name = "workspace_root")

cc_library(
    name = "cxxabi_headers",
    hdrs = [
        "include/__cxxabi_config.h",
        "include/cxxabi.h",
    ],
    includes = ["include"],
)

# Sources from libcxxabi/src/CMakeLists.txt with LIBCXXABI_ENABLE_EXCEPTIONS
# and LIBCXXABI_ENABLE_NEW_DELETE_DEFINITIONS on. cxa_thread_atexit.cpp is
# always listed there and compiles to nothing on targets whose C runtime
# provides __cxa_thread_atexit.
cc_library(
    name = "cxxabi",
    srcs = [
        "src/abort_message.cpp",
        "src/cxa_aux_runtime.cpp",
        "src/cxa_default_handlers.cpp",
        "src/cxa_demangle.cpp",
        "src/cxa_exception.cpp",
        "src/cxa_exception_storage.cpp",
        "src/cxa_guard.cpp",
        "src/cxa_handlers.cpp",
        "src/cxa_personality.cpp",
        "src/cxa_thread_atexit.cpp",
        "src/cxa_vector.cpp",
        "src/cxa_virtual.cpp",
        "src/fallback_malloc.cpp",
        "src/private_typeinfo.cpp",
        "src/stdlib_exception.cpp",
        "src/stdlib_new_delete.cpp",
        "src/stdlib_stdexcept.cpp",
        "src/stdlib_typeinfo.cpp",
    ],
    # Flags from libcxxabi/CMakeLists.txt and libcxxabi/src/CMakeLists.txt.
    copts = [
        "-D_LIBCXXABI_BUILDING_LIBRARY",
        # The libc++ headers are included as if building libc++ itself.
        "-D_LIBCPP_BUILDING_LIBRARY",
        "-D_LIBCPP_AVAILABILITY_MINIMUM_HEADER_VERSION=2",
        # A few sources reuse libc++'s private headers as "include/...".
        "-I$(WORKSPACE_ROOT)/libcxx/src",
        # Keep the toolchain's C++ standard library headers out of the build;
        # libc++abi has to be compiled against the libc++ headers.
        "-nostdinc++",
        "-std=c++23",
        "-fstrict-aliasing",
        "-fsized-deallocation",
    ] + select({
        # CMake skips -fvisibility=hidden on Windows, where it can clash with
        # the dllexport annotations (llvm/llvm-project#207963).
        "@platforms//os:windows": [],
        "//conditions:default": ["-fvisibility=hidden"],
    }),
    linkopts = select({
        # LIBCXXABI_HAS_PTHREAD_LIB on Linux.
        "@platforms//os:linux": ["-lpthread"],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@rules_cc//cc/compiler:clang-cl": ["@platforms//:incompatible"],
        "@rules_cc//cc/compiler:msvc-cl": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    textual_hdrs = glob([
        "src/*.h",
        "src/*.inc",
        "src/demangle/*.def",
        "src/demangle/*.h",
    ]),
    toolchains = [":workspace_root"],
    deps = [
        ":cxxabi_headers",
        "//libcxx:cxx_headers",
        "//libcxx:cxx_src_internal_headers",
    ],
)
