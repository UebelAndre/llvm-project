# Bazel build for libc++, the LLVM C++ standard library.
#
# `:cxx` is a static libc++ that consumers link explicitly through `deps`.
# It is not wired into the C++ toolchain as the default standard library, so
# a consumer still has to make sure these headers win over the toolchain's own
# C++ headers (they are added with -isystem, which Clang and GCC search before
# their built-in C++ include directories).
#
# The configuration mirrors the libcxx/CMakeLists.txt defaults for a hosted
# target: threads, localization, filesystem, random_device, unicode and wide
# characters are on; the time zone database is Linux only; the hardening mode
# is "none"; the PSTL backend is "serial". operator new/delete come from
# libc++abi (LIBCXX_ENABLE_NEW_DELETE_DEFINITIONS=OFF).
#
# Compilers follow libcxx/docs/index.rst: Clang, AppleClang, GCC and clang-cl.
# MSVC's cl.exe cannot build libc++, so the library is marked incompatible with
# it. With clang-cl (MSVC ABI) libc++ sits on top of vcruntime and does not use
# libc++abi, like LIBCXX_CXX_ABI=vcruntime in CMake; everywhere else libc++abi
# is the ABI library and `:cxx` links it. The clang-cl configuration has not
# been exercised by CI.

load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//:workspace_root.bzl", "workspace_root")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
)

licenses(["notice"])

workspace_root(name = "workspace_root")

# Generated headers. These are the three files libcxx/include/CMakeLists.txt
# produces next to the checked-in headers.

# __config_site: feature macros fixed at configuration time. The values are
# what config_define() in libcxx/CMakeLists.txt writes for the defaults.
expand_template(
    name = "config_site_gen",
    out = "include/__config_site",
    substitutions = {
        "#cmakedefine _LIBCPP_ABI_VERSION @_LIBCPP_ABI_VERSION@": "#define _LIBCPP_ABI_VERSION 1",
        "#cmakedefine _LIBCPP_ABI_NAMESPACE @_LIBCPP_ABI_NAMESPACE@": "#define _LIBCPP_ABI_NAMESPACE __1",
        "#cmakedefine01 _LIBCPP_ABI_FORCE_ITANIUM": "#define _LIBCPP_ABI_FORCE_ITANIUM 0",
        "#cmakedefine01 _LIBCPP_ABI_FORCE_MICROSOFT": "#define _LIBCPP_ABI_FORCE_MICROSOFT 0",
        "#cmakedefine01 _LIBCPP_HAS_THREADS": "#define _LIBCPP_HAS_THREADS 1",
        "#cmakedefine01 _LIBCPP_HAS_MONOTONIC_CLOCK": "#define _LIBCPP_HAS_MONOTONIC_CLOCK 1",
        "#cmakedefine01 _LIBCPP_HAS_MUSL_LIBC": "#define _LIBCPP_HAS_MUSL_LIBC 0",
        # No thread API override: <__config> selects pthreads or the Win32
        # API from the target, as it does with the CMake defaults.
        "#cmakedefine01 _LIBCPP_HAS_THREAD_API_PTHREAD": "#define _LIBCPP_HAS_THREAD_API_PTHREAD 0",
        "#cmakedefine01 _LIBCPP_HAS_THREAD_API_EXTERNAL": "#define _LIBCPP_HAS_THREAD_API_EXTERNAL 0",
        "#cmakedefine01 _LIBCPP_HAS_THREAD_API_WIN32": "#define _LIBCPP_HAS_THREAD_API_WIN32 0",
        "#cmakedefine01 _LIBCPP_HAS_THREAD_API_C11": "#define _LIBCPP_HAS_THREAD_API_C11 0",
        "#cmakedefine _LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS": "/* #undef _LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS */",
        "#cmakedefine01 _LIBCPP_HAS_VENDOR_AVAILABILITY_ANNOTATIONS": "#define _LIBCPP_HAS_VENDOR_AVAILABILITY_ANNOTATIONS 0",
        "#cmakedefine _LIBCPP_NO_VCRUNTIME": "/* #undef _LIBCPP_NO_VCRUNTIME */",
        "#cmakedefine _LIBCPP_TYPEINFO_COMPARISON_IMPLEMENTATION @_LIBCPP_TYPEINFO_COMPARISON_IMPLEMENTATION@": "/* #undef _LIBCPP_TYPEINFO_COMPARISON_IMPLEMENTATION */",
        "#cmakedefine01 _LIBCPP_HAS_FILESYSTEM": "#define _LIBCPP_HAS_FILESYSTEM 1",
        "#cmakedefine01 _LIBCPP_HAS_RANDOM_DEVICE": "#define _LIBCPP_HAS_RANDOM_DEVICE 1",
        "#cmakedefine01 _LIBCPP_HAS_LOCALIZATION": "#define _LIBCPP_HAS_LOCALIZATION 1",
        "#cmakedefine01 _LIBCPP_HAS_UNICODE": "#define _LIBCPP_HAS_UNICODE 1",
        "#cmakedefine01 _LIBCPP_HAS_WIDE_CHARACTERS": "#define _LIBCPP_HAS_WIDE_CHARACTERS 1",
        "#cmakedefine01 _LIBCPP_INSTRUMENTED_WITH_ASAN": "#define _LIBCPP_INSTRUMENTED_WITH_ASAN 0",
        "#cmakedefine _LIBCPP_PSTL_BACKEND_SERIAL": "#define _LIBCPP_PSTL_BACKEND_SERIAL",
        "#cmakedefine _LIBCPP_PSTL_BACKEND_STD_THREAD": "/* #undef _LIBCPP_PSTL_BACKEND_STD_THREAD */",
        "#cmakedefine _LIBCPP_PSTL_BACKEND_LIBDISPATCH": "/* #undef _LIBCPP_PSTL_BACKEND_LIBDISPATCH */",
        # 2 is _LIBCPP_HARDENING_MODE_NONE and the "hardening_dependent"
        # assertion semantic; see the hardening block in libcxx/CMakeLists.txt.
        "#cmakedefine _LIBCPP_HARDENING_MODE_DEFAULT @_LIBCPP_HARDENING_MODE_DEFAULT@": "#define _LIBCPP_HARDENING_MODE_DEFAULT 2",
        "#cmakedefine _LIBCPP_ASSERTION_SEMANTIC_DEFAULT @_LIBCPP_ASSERTION_SEMANTIC_DEFAULT@": "#define _LIBCPP_ASSERTION_SEMANTIC_DEFAULT 2",
        "#cmakedefine01 _LIBCPP_LIBC_PICOLIBC": "#define _LIBCPP_LIBC_PICOLIBC 0",
        "#cmakedefine01 _LIBCPP_LIBC_NEWLIB": "#define _LIBCPP_LIBC_NEWLIB 0",
        "#cmakedefine01 _LIBCPP_LIBC_LLVM_LIBC": "#define _LIBCPP_LIBC_LLVM_LIBC 0",
        "@_LIBCPP_ABI_DEFINES@": "",
        "@_LIBCPP_EXTRA_SITE_DEFINES@": "",
    } | select({
        # LIBCXX_ENABLE_TIME_ZONE_DATABASE defaults to ON only on Linux.
        "@platforms//os:linux": {
            "#cmakedefine01 _LIBCPP_HAS_TIME_ZONE_DATABASE": "#define _LIBCPP_HAS_TIME_ZONE_DATABASE 1",
        },
        "//conditions:default": {
            "#cmakedefine01 _LIBCPP_HAS_TIME_ZONE_DATABASE": "#define _LIBCPP_HAS_TIME_ZONE_DATABASE 0",
        },
    }),
    template = "include/__config_site.in",
)

expand_template(
    name = "module_modulemap_gen",
    out = "include/module.modulemap",
    substitutions = {
        "@LIBCXX_CONFIG_SITE_MODULE_ENTRY@": "textual header \"__config_site\"",
    },
    template = "include/module.modulemap.in",
)

# CMake copies the default assertion handler verbatim (configure_file COPYONLY).
copy_file(
    name = "assertion_handler_gen",
    src = "vendor/llvm/default_assertion_handler.in",
    out = "include/__assertion_handler",
)

_LIBCXX_HDRS = glob(
    ["include/**"],
    exclude = [
        "include/**/*.in",
        "include/**/CMakeLists.txt",
    ],
) + [
    ":assertion_handler_gen",
    ":config_site_gen",
    ":module_modulemap_gen",
]

# Header-only view of libc++, for libc++abi (which libc++ links, so it cannot
# depend on `:cxx`) and for header-only consumers. `:cxx` exports the same
# headers, so consumers of the library do not need both.
cc_library(
    name = "cxx_headers",
    hdrs = _LIBCXX_HDRS,
    includes = ["include"],
)

# Private headers under src/ that libc++abi shares with libc++
# (libcxxabi/src/CMakeLists.txt adds libcxx/src to its include path).
cc_library(
    name = "cxx_src_internal_headers",
    textual_hdrs = glob([
        "src/include/**/*.h",
        "src/support/*.ipp",
    ]),
    visibility = ["//libcxxabi:__pkg__"],
)

# Flags from cxx_add_basic_build_flags() in libcxx/CMakeLists.txt.
_LIBCXX_COPTS = [
    "-D_LIBCPP_BUILDING_LIBRARY",
    "-D_LIBCPP_AVAILABILITY_MINIMUM_HEADER_VERSION=2",
    "-D_LIBCPP_REMOVE_TRANSITIVE_INCLUDES",
    # The sources include their private headers as "include/..." relative to
    # libcxx/src, which CMake puts on the include path.
    "-I$(WORKSPACE_ROOT)/libcxx/src",
    # from_chars for floating-point types is implemented with LLVM libc's
    # shared headers, included as "shared/..." relative to the libc root
    # (cmake/Modules/FindLibcCommonUtils.cmake).
    "-I$(WORKSPACE_ROOT)/libc",
    "-DLIBC_NAMESPACE=__llvm_libc_common_utils",
] + select({
    "@rules_cc//cc/compiler:clang-cl": [
        "/std:c++latest",
        # cxx_add_windows_flags() for the MSVC CRT.
        "-D_ALLOW_MSC_VER_MISMATCH",
        "-D_ALLOW_ITERATOR_DEBUG_LEVEL_MISMATCH",
        "-D_CRTBLD",
        "-D_CRT_SECURE_NO_WARNINGS",
        "-D_CRT_STDIO_ISO_WIDE_SPECIFIERS",
    ],
    "//conditions:default": [
        # Keep the toolchain's C++ standard library headers out of the build;
        # the library has to be compiled against its own headers.
        "-nostdinc++",
        "-std=c++26",
        "-fvisibility=hidden",
        "-fvisibility-inlines-hidden",
        "-fsized-deallocation",
        # Selects the libc++abi flavors of the exception and stdexcept runtime
        # (libcxx/cmake/Modules/HandleLibCXXABI.cmake).
        "-DLIBCXX_BUILDING_LIBCXXABI",
        # Suppressions from runtimes/cmake/Modules/WarningFlags.cmake that
        # apply to the library sources.
        "-Wno-user-defined-literals",
        "-Wno-covered-switch-default",
        "-Wno-suggest-override",
    ],
}) + select({
    "@rules_cc//cc/compiler:clang": ["-faligned-allocation"],
    "//conditions:default": [],
})

# libc++ cannot be built with cl.exe.
_LIBCXX_COMPATIBLE_WITH = select({
    "@rules_cc//cc/compiler:msvc-cl": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Sources from libcxx/src/CMakeLists.txt with LIBCXX_ENABLE_THREADS,
# LIBCXX_ENABLE_RANDOM_DEVICE, LIBCXX_ENABLE_LOCALIZATION and
# LIBCXX_ENABLE_FILESYSTEM on, and LIBCXX_ENABLE_NEW_DELETE_DEFINITIONS off
# (operator new/delete come from libc++abi; defining them in both libraries
# is an ODR violation).
cc_library(
    name = "cxx",
    srcs = [
        "src/algorithm.cpp",
        "src/any.cpp",
        "src/atomic.cpp",
        "src/barrier.cpp",
        "src/bind.cpp",
        "src/call_once.cpp",
        "src/charconv.cpp",
        "src/chrono.cpp",
        "src/condition_variable.cpp",
        "src/condition_variable_destructor.cpp",
        "src/debugging.cpp",
        "src/error_category.cpp",
        "src/exception.cpp",
        "src/expected.cpp",
        "src/filesystem/directory_entry.cpp",
        "src/filesystem/directory_iterator.cpp",
        "src/filesystem/filesystem_clock.cpp",
        "src/filesystem/filesystem_error.cpp",
        "src/filesystem/int128_builtins.cpp",
        "src/filesystem/operations.cpp",
        "src/filesystem/path.cpp",
        "src/fstream.cpp",
        "src/functional.cpp",
        "src/future.cpp",
        "src/hash.cpp",
        "src/ios.cpp",
        "src/ios.instantiations.cpp",
        "src/iostream.cpp",
        "src/locale.cpp",
        "src/memory.cpp",
        "src/memory_resource.cpp",
        "src/mutex.cpp",
        "src/mutex_destructor.cpp",
        "src/new_handler.cpp",
        "src/new_helpers.cpp",
        "src/optional.cpp",
        "src/ostream.cpp",
        "src/print.cpp",
        "src/random.cpp",
        "src/random_shuffle.cpp",
        "src/regex.cpp",
        "src/ryu/d2fixed.cpp",
        "src/ryu/d2s.cpp",
        "src/ryu/f2s.cpp",
        "src/shared_mutex.cpp",
        "src/stdexcept.cpp",
        "src/string.cpp",
        "src/strstream.cpp",
        "src/system_error.cpp",
        "src/text_encoding.cpp",
        "src/thread.cpp",
        "src/typeinfo.cpp",
        "src/valarray.cpp",
        "src/variant.cpp",
        "src/vector.cpp",
        "src/verbose_abort.cpp",
    ] + select({
        "@platforms//os:windows": [
            "src/support/win32/compiler_rt_shims.cpp",
            "src/support/win32/locale_win32.cpp",
            "src/support/win32/support.cpp",
            "src/support/win32/thread_win32.cpp",
        ],
        "//conditions:default": [],
    }),
    hdrs = _LIBCXX_HDRS,
    copts = _LIBCXX_COPTS,
    includes = ["include"],
    linkopts = select({
        "@rules_cc//cc/compiler:clang-cl": ["/DEFAULTLIB:iso_stdio_wide_specifiers.lib"],
        "//conditions:default": [],
    }),
    target_compatible_with = _LIBCXX_COMPATIBLE_WITH,
    textual_hdrs = glob([
        "src/*.h",
        "src/debugging/*.ipp",
        "src/filesystem/*.h",
        "src/include/**/*.h",
        "src/support/*.ipp",
        "src/support/runtime/*.ipp",
    ]),
    toolchains = [":workspace_root"],
    deps = [
        "//libc:libcxx_shared_headers",
    ] + select({
        "@rules_cc//cc/compiler:clang-cl": [],
        "//conditions:default": [
            "//libcxxabi:cxxabi",
            "//libcxxabi:cxxabi_headers",
        ],
    }),
)

# libc++experimental: the pieces that are not yet part of the stable ABI
# (currently the <chrono> time zone database on Linux and the hardening
# failure logger). Consumers that use them link this in addition to `:cxx`.
cc_library(
    name = "cxx_experimental",
    srcs = [
        "src/experimental/keep.cpp",
        "src/experimental/log_hardening_failure.cpp",
    ] + select({
        "@platforms//os:linux": [
            "src/experimental/chrono_exception.cpp",
            "src/experimental/time_zone.cpp",
            "src/experimental/tzdb.cpp",
            "src/experimental/tzdb_list.cpp",
        ],
        "//conditions:default": [],
    }),
    copts = _LIBCXX_COPTS + ["-D_LIBCPP_ENABLE_EXPERIMENTAL"],
    target_compatible_with = _LIBCXX_COMPATIBLE_WITH,
    textual_hdrs = glob(["src/experimental/include/tzdb/*.h"]),
    toolchains = [":workspace_root"],
    deps = [":cxx"],
)
